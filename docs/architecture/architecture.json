    "legend": {
      "mode": "auto",
      "entries": {
        "frontend": {
          "label": "Vista (Activities, Fragment, Adapter)"
        },
        "backend": {
          "label": "Lógica (ViewModel y Repository)"
        },
        "cloud": {
          "label": "Red (Retrofit)"
        },
        "external": {
          "label": "API externa"
        },
        "database": {
          "label": "Modelos de datos"
        },
        "messagebus": {
          "label": "Utilidades (estado y errores)"
        }
      }
    },
    "views": [
      {
        "id": "flujo-busqueda",
        "label": "1. Flujo de búsqueda",
        "focus": [
          "mainActivity",
          "searchViewModel",
          "bookRepository",
          "openLibraryApi",
          "retrofitClient",
          "openLibrary",
          "bookAdapter"
        ],
        "note": "El usuario busca: MainActivity → SearchViewModel → BookRepository → Retrofit → API; la lista vuelve y BookAdapter la dibuja."
      },
      {
        "id": "flujo-detalle",
        "label": "2. Flujo de detalle",
        "focus": [
          "mainActivity",
          "detailActivity",
          "bookDetailFragment",
          "bookDetailViewModel",
          "bookRepository",
          "bookDetail"
        ],
        "note": "Al tocar un libro, el workId viaja por Intent a DetailActivity y por arguments al Fragment, que pide el detalle."
      },
      {
        "id": "capa-datos",
        "label": "3. Capa de datos",
        "focus": [
          "bookRepository",
          "openLibraryApi",
          "retrofitClient",
          "openLibrary",
          "book",
          "searchResponse",
          "workDetail",
          "bookDetail"
        ],
        "note": "El Repository es la única puerta a los datos: llama a la API, Gson convierte el JSON y se arma el BookDetail."
      },
      {
        "id": "manejo-errores",
        "label": "4. Estados y errores",
        "focus": [
          "searchViewModel",
          "bookDetailViewModel",
          "uiState",
          "errorMapper",
          "bookRepository"
        ],
        "note": "safeApiCall devuelve un Result; el ViewModel traduce el error con ErrorMapper y emite Loading, Success o Error."
      }
    ],
