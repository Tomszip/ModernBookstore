  "cards": [
    {
      "dot": "cyan",
      "title": "Vista (ui)",
      "items": [
        "Activities y Fragment solo dibujan el UiState",
        "workId viaja por Intent y luego por arguments"
      ]
    },
    {
      "dot": "emerald",
      "title": "ViewModel + Repository",
      "items": [
        "ViewModel: corrutinas + LiveData, sobrevive a rotar",
        "Repository: única puerta a los datos → Result"
      ]
    },
    {
      "dot": "violet",
      "title": "Datos y errores",
      "items": [
        "Retrofit + Gson: JSON → data classes",
        "ErrorMapper: sin red, timeout o HTTP → mensaje"
      ]
    }
  ]
